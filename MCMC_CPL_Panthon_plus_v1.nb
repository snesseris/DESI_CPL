            RowBox[{"{", 
             RowBox[{"ompl", ",", 
              RowBox[{"-", "2"}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"ompl", ",", "0"}], "}"}]}], "}"}], "]"}]}], "}"}]}], 
      "}"}]}]}], "]"}]}]}], "Input",

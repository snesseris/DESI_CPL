         RowBox[{"skd", ",", "datapl"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"cons", "=", 
        RowBox[{"Quantile", "[", 
         RowBox[{"pdf", ",", 
          RowBox[{
           RowBox[{"1", "-", 

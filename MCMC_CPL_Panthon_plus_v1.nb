Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"This", " ", "is", " ", "the", " ", "jump", " ", "function"}], 
    " ", "//", " ", 
    RowBox[{"Proposes", " ", "the", " ", "next", " ", "point"}]}], " ", 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"jumpfunc", "[", 
     RowBox[{"point_", ",", "s_"}], "]"}], ":=", 
    RowBox[{"point", "+", 
     RowBox[{"RandomVariate", "[", 
      RowBox[{
       RowBox[{"NormalDistribution", "[", 
        RowBox[{"0", ",", "s"}], "]"}], ",", 
       RowBox[{"Length", "[", "point", "]"}]}], "]"}]}]}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"jumpfuncmat", "[", 
     RowBox[{"point_", ",", "cijtest_"}], "]"}], ":=", 
    RowBox[{"RandomVariate", "[", 
     RowBox[{"MultinormalDistribution", "[", 
      RowBox[{"point", ",", "cijtest"}], "]"}], "]"}]}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      SuperscriptBox["\[CapitalDelta]\[Chi]", "2"], " ", "for", " ", "2", " ",
       "params"}], ",", " ", 
     RowBox[{"up", " ", "to", " ", "3", "\[Sigma]"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"dx2", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"2", " ", 
          RowBox[{"InverseGammaRegularized", "[", 
           RowBox[{
            FractionBox["Nn", "2"], ",", 
            RowBox[{"1", "-", 
             RowBox[{"Erf", "[", 
              FractionBox["x\[Sigma]", 
               SqrtBox["2"]], "]"}]}]}], "]"}]}], "/.", 
         RowBox[{"Nn", "\[Rule]", "2"}]}], "//", "N"}], ",", 
       RowBox[{"{", 
        RowBox[{"x\[Sigma]", ",", "1", ",", "3"}], "}"}]}], "]"}]}], ";"}], 
   "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"mysymmetrize", "[", "Cij_", "]"}], ":=", 
     FractionBox[
      RowBox[{"Cij", "+", 
       RowBox[{"Transpose", "[", "Cij", "]"}]}], "2"]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"Contours", "+", 
       RowBox[{"color", " ", "from", " ", "the", " ", "MCMC"}]}], " ", "//", 
      " ", 
      RowBox[{"Uses", " ", "ConvexHull"}]}], " ", "//", " ", 
     RowBox[{"Advanced", "++"}]}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Needs", "[", "\"\<ComputationalGeometry`\>\"", "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Off", "[", 
     StyleBox[
      RowBox[{"CompiledFunction", "::", "cflist"}], "MessageName"], 
     StyleBox["]", "MessageName"]}], 
    StyleBox[";", "MessageName"]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Confid2D", "[", 
     RowBox[{"data_List", ",", "color_", ",", "inter_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"cv", ",", "cv1", ",", "cv2", ",", "qq"}], "}"}], ",", 
      RowBox[{
       RowBox[{"cv", "=", 
        RowBox[{"ConvexHull", "[", 
         RowBox[{"data", ",", 
          RowBox[{"AllPoints", "\[Rule]", "True"}]}], "]"}]}], ";", 
       RowBox[{"cv1", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"data", "[", 
           RowBox[{"[", "#", "]"}], "]"}], "&"}], "/@", "cv"}]}], ";", 
       RowBox[{"cv2", "=", 
        RowBox[{"Join", "[", 
         RowBox[{"cv1", ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"cv1", "[", 
             RowBox[{"[", "1", "]"}], "]"}], ",", 
            RowBox[{"cv1", "[", 
             RowBox[{"[", "2", "]"}], "]"}]}], "}"}]}], "]"}]}], ";", 
       RowBox[{"qq", "=", 
        RowBox[{"Show", "[", 
         RowBox[{
          RowBox[{"Graphics", "[", 
           RowBox[{"{", 
            RowBox[{"color", ",", 
             RowBox[{"FilledCurve", "[", 
              RowBox[{"BSplineCurve", "[", 
               RowBox[{"cv2", ",", 
                RowBox[{"SplineDegree", "\[Rule]", "inter"}], ",", 
                RowBox[{"SplineKnots", "\[Rule]", "\"\<Unclamped\>\""}]}], 
               "]"}], "]"}], ",", 
             RowBox[{"Antialiasing", "\[Rule]", "True"}]}], "}"}], "]"}], ",", 
          RowBox[{"Frame", "\[Rule]", "True"}]}], "]"}]}], ";", "qq"}]}], 
     "]"}]}], "\n", 
   RowBox[{
    RowBox[{"normalize", "[", 
     RowBox[{"bins_", ",", "counts_"}], "]"}], ":=", 
    RowBox[{"counts", "/", 
     RowBox[{"Max", "[", "counts", "]"}]}]}], "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"Convergence", " ", "diagnostics"}], " ", "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Rstatistic", "[", 
     RowBox[{"chain_", ",", "param_", ",", "burnin_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"n", ",", "m", ",", "W", ",", "B", ",", "Rminus1"}], "}"}], 
      ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"m", "=", 
        RowBox[{"chain", "//", "Length"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"n", "=", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"chain", "[", 
             RowBox[{"[", 
              RowBox[{"i", ",", 
               RowBox[{"burnin", ";;", 
                RowBox[{"-", "1"}]}], ",", "1", ",", "param"}], "]"}], "]"}], 
            "//", "Length"}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "1", ",", "m"}], "}"}]}], "]"}], "//", 
         "Mean"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"W", "=", 
        RowBox[{"Mean", "[", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"Variance", "[", 
            RowBox[{"chain", "[", 
             RowBox[{"[", 
              RowBox[{"j", ",", 
               RowBox[{"burnin", ";;", 
                RowBox[{"-", "1"}]}], ",", "1", ",", "param"}], "]"}], "]"}], 
            "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"j", ",", "1", ",", "m"}], "}"}]}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"B", "=", 
        RowBox[{"n", " ", 
         RowBox[{"Variance", "[", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"Mean", "[", 
             RowBox[{"chain", "[", 
              RowBox[{"[", 
               RowBox[{"j", ",", 
                RowBox[{"burnin", ";;", 
                 RowBox[{"-", "1"}]}], ",", "1", ",", "param"}], "]"}], "]"}],
              "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"j", ",", "1", ",", "m"}], "}"}]}], "]"}], "]"}]}]}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{"Rminus1", "=", 
        RowBox[{
         SqrtBox[
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", "-", 
             FractionBox["1", "n"]}], ")"}], "+", 
           RowBox[{
            FractionBox["1", "n"], 
            FractionBox["B", "W"]}]}]], "-", "1"}]}]}]}], "]"}]}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", "Utils", " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"time", "[", "dt1_", "]"}], ":=", 
    RowBox[{"Which", "[", 
     RowBox[{
      RowBox[{"dt1", "<", "60"}], ",", 
      RowBox[{
       RowBox[{"ToString", "[", "dt1", "]"}], "<>", "\"\< secs\>\""}], ",", 
      RowBox[{"60", "\[LessEqual]", "dt1", "<", "1000"}], ",", 
      RowBox[{
       RowBox[{"ToString", "[", 
        RowBox[{"dt1", "/", "60."}], "]"}], "<>", "\"\< mins\>\""}], ",", 
      RowBox[{"1000", "\[LessEqual]", "dt1"}], ",", 
      RowBox[{
       RowBox[{"ToString", "[", 
        RowBox[{"dt1", "/", "3600."}], "]"}], "<>", "\"\< hrs\>\""}]}], 
     "]"}]}]}]}]], "Input",
 InitializationGroup->True,

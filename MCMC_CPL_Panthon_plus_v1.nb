Cell[BoxData[{
 RowBox[{
  RowBox[{"pp", "=", 
   RowBox[{"{", 
    RowBox[{"2", ",", "3"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"datapl", "=", 
   RowBox[{"MCMCchain", "[", 
    RowBox[{"[", 
     RowBox[{"All", ",", "1", ",", "pp"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"skd", "=", 
   RowBox[{"SmoothKernelDistribution", "[", "datapl", "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"pdf", "=", 
   RowBox[{"PDF", "[", 
    RowBox[{"skd", ",", "datapl"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"cons", "=", 
   RowBox[{"Quantile", "[", 
    RowBox[{"pdf", ",", 
     RowBox[{
      RowBox[{
       RowBox[{"1", "-", 
        RowBox[{"Erf", "[", 
         FractionBox["nn", 
          SqrtBox["2"]], "]"}]}], "/.", 
       RowBox[{"nn", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{"1", ",", "2"}], "}"}]}]}], "//", "N"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"cenp", "=", 

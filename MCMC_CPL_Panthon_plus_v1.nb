Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Rescale", " ", 
    SubscriptBox["\[CapitalOmega]", "b"], 
    SuperscriptBox["h", "2"], " ", "to", " ", "100", "*", 
    SubscriptBox["\[CapitalOmega]", "b"], 
    SuperscriptBox["h", "2"], " ", "to", " ", "avoid", " ", "problems", " ", 
    "with", " ", "the", " ", "graphics"}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"mcmcchain", "=", "bigchain"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "The", " ", "parameters", " ", "of", " ", "the", " ", "chains", " ", "as",
      " ", "they", " ", "will", " ", "appear", " ", "in", " ", "the", " ", 
     "plot", " ", "and", " ", "some", " ", "default", " ", 
     RowBox[{"(", "Planck", ")"}], " ", "values"}], " ", "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"def", "=", 
     RowBox[{"{", 
      RowBox[{"ompl", ",", 
       RowBox[{"-", "1"}], ",", "0", ",", "0", ",", "hpl"}], "}"}]}], ";"}], 
   "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Calculate", " ", "the", " ", "ranges", " ", "of", " ", "the", " ", 
     "plots", " ", "and", " ", "number", " ", "of", " ", "ticks", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"default", " ", "ndivs"}], "+", "1"}], ")"}], ".", " ", 
      "Set"}], " ", "the", " ", 
     RowBox[{"fontsize", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"fontsize", "=", "12"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ndivs", "=", "5"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"nmax", "=", 
     RowBox[{"Length", "[", "params", "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"lims", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Min", "[", 
          RowBox[{"mcmcchain", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", "1", ",", "i"}], "]"}], "]"}], "]"}], ",", 
         RowBox[{"Max", "[", 
          RowBox[{"mcmcchain", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", "1", ",", "i"}], "]"}], "]"}], "]"}]}], "}"}],
        ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", "nmax"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"divs", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"FindDivisions", "[", 
         RowBox[{
          RowBox[{"lims", "[", 
           RowBox[{"[", "i", "]"}], "]"}], ",", "ndivs"}], "]"}], "//", "N"}],
        ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", "nmax"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ranges", "=", 

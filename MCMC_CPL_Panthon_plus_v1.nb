Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"This", " ", "makes", " ", "the", " ", "1", "D"}], ",", " ", 
    RowBox[{
    "2", "D", " ", "plots", " ", "and", " ", "the", " ", "Triangle", " ", 
     "plot"}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"pl1d", "[", "i_", "]"}], ":=", 
    RowBox[{"SmoothHistogram", "[", 
     RowBox[{
      RowBox[{"mcmcchain", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", "1", ",", "i"}], "]"}], "]"}], ",", "Automatic", 
      ",", "\"\<PDF\>\"", ",", 
      RowBox[{"Frame", "\[Rule]", "True"}], ",", 
      RowBox[{"PlotRange", "\[Rule]", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"ranges", "[", 
          RowBox[{"[", "i", "]"}], "]"}], ",", "All"}], "}"}]}], ",", 
      RowBox[{"AspectRatio", "\[Rule]", "1"}], ",", 
      RowBox[{"FrameLabel", "\[Rule]", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"params", "[", 
          RowBox[{"[", "i", "]"}], "]"}], ",", "None"}], "}"}]}], ",", 
      RowBox[{"FrameTicks", "\[Rule]", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"None", ",", "None"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"divs", "[", 
            RowBox[{"[", "i", "]"}], "]"}], ",", 
           RowBox[{"Transpose", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"divs", "[", 
               RowBox[{"[", "i", "]"}], "]"}], ",", 
              RowBox[{"Table", "[", 
               RowBox[{"\"\<\>\"", ",", 
                RowBox[{"Length", "[", 
                 RowBox[{"divs", "[", 
                  RowBox[{"[", "i", "]"}], "]"}], "]"}]}], "]"}]}], "}"}], 
            "]"}]}], "}"}]}], "}"}]}], ",", 
      RowBox[{"BaseStyle", "\[Rule]", 
       RowBox[{"FontSize", "\[Rule]", "fontsize"}]}], ",", 
      RowBox[{"Axes", "\[Rule]", "False"}], ",", 
      RowBox[{"FrameStyle", "\[Rule]", "Black"}], ",", 
      RowBox[{"PlotStyle", "\[Rule]", "Black"}], ",", 
      RowBox[{"Epilog", "\[Rule]", 
       RowBox[{"{", 
        RowBox[{"Black", ",", "Dashed", ",", 
         RowBox[{"Line", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"def", "[", 
               RowBox[{"[", "i", "]"}], "]"}], ",", "0"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"def", "[", 
               RowBox[{"[", "i", "]"}], "]"}], ",", 
              SuperscriptBox["10", "5"]}], "}"}]}], "}"}], "]"}]}], "}"}]}]}],
      "]"}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"pl2d", "[", 
     RowBox[{"i_", ",", "j_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"datapl", ",", "skd", ",", "pdf", ",", "cons", ",", "cenp"}], 
       "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"datapl", "=", 
        RowBox[{"mcmcchain", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "1", ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "j"}], "}"}]}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"skd", "=", 
        RowBox[{"SmoothKernelDistribution", "[", "datapl", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"pdf", "=", 
        RowBox[{"PDF", "[", 
         RowBox[{"skd", ",", "datapl"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"cons", "=", 
        RowBox[{"Quantile", "[", 
         RowBox[{"pdf", ",", 
          RowBox[{
           RowBox[{"1", "-", 
            RowBox[{"Erf", "[", 
             FractionBox[
              RowBox[{"{", 
               RowBox[{"1", ",", "2", ",", "3"}], "}"}], 
              SqrtBox["2"]], "]"}]}], "//", "N"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"cenp", "=", 
        RowBox[{"datapl", "//", "Mean"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"ContourPlot", "[", 
        RowBox[{
         RowBox[{"PDF", "[", 
          RowBox[{"skd", ",", 
           RowBox[{"{", 
            RowBox[{"a", ",", "b"}], "}"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"a", ",", " ", 
           RowBox[{"ranges", "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", "1"}], "]"}], "]"}], ",", 
           RowBox[{"ranges", "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", "2"}], "]"}], "]"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"b", ",", " ", 
           RowBox[{"ranges", "[", 
            RowBox[{"[", 
             RowBox[{"j", ",", "1"}], "]"}], "]"}], ",", " ", 
           RowBox[{"ranges", "[", 
            RowBox[{"[", 
             RowBox[{"j", ",", "2"}], "]"}], "]"}]}], "}"}], ",", 
         RowBox[{"Contours", "\[Rule]", "cons"}], ",", 
         RowBox[{"ContourShading", "\[Rule]", 
          RowBox[{"{", 
           RowBox[{"White", ",", 
            RowBox[{"Hue", "[", 
             RowBox[{"0.6", ",", "0.5", ",", "0.8"}], "]"}], ",", 
            RowBox[{"Hue", "[", 
             RowBox[{"0.55", ",", "0.5", ",", "0.8"}], "]"}], ",", 
            RowBox[{"Hue", "[", 
             RowBox[{"0.5", ",", "0.5", ",", "0.9"}], "]"}]}], "}"}]}], ",", 
         RowBox[{"FrameLabel", "\[Rule]", 
          RowBox[{"params", "[", 
           RowBox[{"[", 
            RowBox[{"{", 
             RowBox[{"i", ",", "j"}], "}"}], "]"}], "]"}]}], ",", 
         RowBox[{"FrameTicks", "\[Rule]", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"divs", "[", 
               RowBox[{"[", "j", "]"}], "]"}], ",", 
              RowBox[{"Transpose", "[", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"divs", "[", 
                  RowBox[{"[", "j", "]"}], "]"}], ",", 
                 RowBox[{"Table", "[", 
                  RowBox[{"\"\<\>\"", ",", 
                   RowBox[{"Length", "[", 
                    RowBox[{"divs", "[", 
                    RowBox[{"[", "j", "]"}], "]"}], "]"}]}], "]"}]}], "}"}], 
               "]"}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"divs", "[", 
               RowBox[{"[", "i", "]"}], "]"}], ",", 
              RowBox[{"Transpose", "[", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"divs", "[", 
                  RowBox[{"[", "i", "]"}], "]"}], ",", 
                 RowBox[{"Table", "[", 
                  RowBox[{"\"\<\>\"", ",", 
                   RowBox[{"Length", "[", 
                    RowBox[{"divs", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "]"}]}], "]"}]}], "}"}], 
               "]"}]}], "}"}]}], "}"}]}], ",", 
         RowBox[{"BaseStyle", "\[Rule]", 
          RowBox[{"FontSize", "\[Rule]", "fontsize"}]}], ",", 
         RowBox[{"PlotRange", "\[Rule]", "All"}], ",", 
         RowBox[{"FrameStyle", "\[Rule]", "Black"}], ",", 
         RowBox[{"ClippingStyle", "\[Rule]", "None"}], ",", 
         RowBox[{"Epilog", "\[Rule]", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"Black", ",", 
              RowBox[{"Point", "[", "cenp", "]"}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"Red", ",", 
              RowBox[{"Point", "[", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"def", "[", 
                  RowBox[{"[", "i", "]"}], "]"}], ",", 
                 RowBox[{"def", "[", 
                  RowBox[{"[", "j", "]"}], "]"}]}], "}"}], "]"}]}], "}"}]}], 
           "}"}]}]}], "]"}]}]}], "]"}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"tab", "[", 
     RowBox[{"i_", ",", "j_"}], "]"}], ":=", 
    RowBox[{"Which", "[", 
     RowBox[{
      RowBox[{"i", "\[Equal]", "j"}], ",", 
      RowBox[{"pl1d", "[", "i", "]"}], ",", 
      RowBox[{"i", "<", "j"}], ",", 
      RowBox[{"pl2d", "[", 
       RowBox[{"i", ",", "j"}], "]"}], ",", 
      RowBox[{"i", "\[Equal]", 
       RowBox[{"j", "+", "1"}]}], ",", "pleint", ",", "True", ",", "pleout"}],
      "]"}]}]}]}]], "Input",

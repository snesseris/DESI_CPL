   RowBox[{"{", 
    RowBox[{"2", ",", "3"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"datapl", "=", 
   RowBox[{"MCMCchain", "[", 
    RowBox[{"[", 
     RowBox[{"All", ",", "1", ",", "pp"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"skd", "=", 
   RowBox[{"SmoothKernelDistribution", "[", "datapl", "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"pdf", "=", 
   RowBox[{"PDF", "[", 
    RowBox[{"skd", ",", "datapl"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"cons", "=", 
   RowBox[{"Quantile", "[", 
    RowBox[{"pdf", ",", 
     RowBox[{
      RowBox[{
       RowBox[{"1", "-", 
        RowBox[{"Erf", "[", 
         FractionBox["nn", 
          SqrtBox["2"]], "]"}]}], "/.", 
       RowBox[{"nn", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{"1", ",", "2"}], "}"}]}]}], "//", "N"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"cenp", "=", 
   RowBox[{"datapl", "//", "Mean"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"con1", "=", 
  RowBox[{"ContourPlot", "[", 
   RowBox[{
    RowBox[{"PDF", "[", 
     RowBox[{"skd", ",", 
      RowBox[{"{", 
       RowBox[{"a", ",", "b"}], "}"}]}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"a", ",", " ", 
      RowBox[{"-", "2"}], ",", "0"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"b", ",", " ", 
      RowBox[{"-", "8"}], ",", " ", "8"}], "}"}], ",", 
    RowBox[{"Contours", "\[Rule]", "cons"}], ",", 
    RowBox[{"ContourShading", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"White", ",", 
       RowBox[{"Hue", "[", 
        RowBox[{"0.55", ",", "0.5", ",", "0.8"}], "]"}], ",", 
       RowBox[{"Hue", "[", 
        RowBox[{"0.6", ",", "0.5", ",", "0.8"}], "]"}]}], "}"}]}], ",", 
    RowBox[{"FrameLabel", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{
      "\"\<\!\(\*SubscriptBox[\(w\), \(0\)]\)\>\"", ",", 
       "\"\<\!\(\*SubscriptBox[\(w\), \(a\)]\)\>\""}], "}"}]}], ",", 
    RowBox[{"BaseStyle", "\[Rule]", 
     RowBox[{"FontSize", "\[Rule]", "14"}]}], ",", 
    RowBox[{"PlotRange", "\[Rule]", "All"}], ",", 
    RowBox[{"FrameStyle", "\[Rule]", "Black"}], ",", 
    RowBox[{"ClippingStyle", "\[Rule]", "None"}], ",", 
    RowBox[{"AspectRatio", "->", "0.8"}], ",", 
    RowBox[{"Epilog", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"Black", ",", 
         RowBox[{"Point", "[", "cenp", "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"Dashed", ",", 
         RowBox[{"Line", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "1"}], ",", 
              RowBox[{"-", "8"}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "1"}], ",", "8"}], "}"}]}], "}"}], "]"}]}], "}"}], 
       ",", 
       RowBox[{"{", 
        RowBox[{"Dashed", ",", 
         RowBox[{"Line", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "2"}], ",", "0"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"0", ",", "0"}], "}"}]}], "}"}], "]"}]}], "}"}]}], 
      "}"}]}]}], "]"}]}]}], "Input",

Cell[BoxData[
 RowBox[{
  RowBox[{"MCMCchain", "=", 
   RowBox[{"bigchain", "[", 
    RowBox[{"[", 
     RowBox[{"burnin", ";;", 
      RowBox[{"-", "1"}]}], "]"}], "]"}]}], ";"}]], "Input",

             FractionBox[
              RowBox[{"{", 
               RowBox[{"1", ",", "2", ",", "3"}], "}"}], 
              SqrtBox["2"]], "]"}]}], "//", "N"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"cenp", "=", 
        RowBox[{"datapl", "//", "Mean"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"ContourPlot", "[", 
        RowBox[{
         RowBox[{"PDF", "[", 
          RowBox[{"skd", ",", 
           RowBox[{"{", 
            RowBox[{"a", ",", "b"}], "}"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"a", ",", " ", 

Cell[BoxData[{
 RowBox[{
  RowBox[{"pp", "=", 
   RowBox[{"{", 
    RowBox[{"2", ",", "5"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"datapl", "=", 
   RowBox[{"MCMCchain", "[", 
    RowBox[{"[", 
     RowBox[{"All", ",", "1", ",", "pp"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"skd", "=", 
   RowBox[{"SmoothKernelDistribution", "[", "datapl", "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"pdf", "=", 

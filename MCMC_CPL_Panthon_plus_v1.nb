Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"pp", "=", 
   RowBox[{"{", 
    RowBox[{"1", ",", "2"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"datapl", "=", 
   RowBox[{"MCMCchain", "[", 
    RowBox[{"[", 
     RowBox[{"All", ",", "1", ",", "pp"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"skd", "=", 
   RowBox[{"SmoothKernelDistribution", "[", "datapl", "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"pdf", "=", 
   RowBox[{"PDF", "[", 
    RowBox[{"skd", ",", "datapl"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"cons", "=", 
   RowBox[{"Quantile", "[", 
    RowBox[{"pdf", ",", 
     RowBox[{
      RowBox[{
       RowBox[{"1", "-", 
        RowBox[{"Erf", "[", 
         FractionBox["nn", 
          SqrtBox["2"]], "]"}]}], "/.", 
       RowBox[{"nn", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{"1", ",", "2"}], "}"}]}]}], "//", "N"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"cenp", "=", 
   RowBox[{"datapl", "//", "Mean"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"con1", "=", 
  RowBox[{"ContourPlot", "[", 
   RowBox[{
    RowBox[{"PDF", "[", 
     RowBox[{"skd", ",", 
      RowBox[{"{", 
       RowBox[{"a", ",", "b"}], "}"}]}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"a", ",", " ", "0.1", ",", "0.5"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"b", ",", " ", 
      RowBox[{"-", "1.6"}], ",", " ", 
      RowBox[{"-", "0.2"}]}], "}"}], ",", 
    RowBox[{"Contours", "\[Rule]", "cons"}], ",", 
    RowBox[{"ContourShading", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"White", ",", 
       RowBox[{"Lighter", "[", 
        StyleBox[
         RowBox[{"RGBColor", "[", 
          RowBox[{"1", ",", "0.5", ",", "0"}], "]"}],
         ShowSpecialCharacters->False,
         ShowStringCharacters->True,
         NumberMarks->True], 
        StyleBox["]",
         ShowSpecialCharacters->False,
         ShowStringCharacters->True,
         NumberMarks->True]}], ",", 
       StyleBox[
        RowBox[{"RGBColor", "[", 
         RowBox[{"1", ",", "0.5", ",", "0"}], "]"}],
        ShowSpecialCharacters->False,
        ShowStringCharacters->True,
        NumberMarks->True]}], "}"}]}], ",", 
    RowBox[{"FrameLabel", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{
      "\"\<\!\(\*SubscriptBox[\(\[CapitalOmega]\), \(m\)]\)\>\"", ",", 
       "\"\<w\>\""}], "}"}]}], ",", 
    RowBox[{"BaseStyle", "\[Rule]", 
     RowBox[{"FontSize", "\[Rule]", "14"}]}], ",", 
    RowBox[{"PlotRange", "\[Rule]", "All"}], ",", 
    RowBox[{"FrameStyle", "\[Rule]", "Black"}], ",", 
    RowBox[{"ClippingStyle", "\[Rule]", "None"}], ",", 
    RowBox[{"AspectRatio", "->", "0.8"}], ",", 
    RowBox[{"Epilog", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"Black", ",", 
         RowBox[{"Point", "[", "cenp", "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"Dashed", ",", 
         RowBox[{"Line", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"0", ",", 
              RowBox[{"-", "1"}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"0.5", ",", 
              RowBox[{"-", "1"}]}], "}"}]}], "}"}], "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"Dashed", ",", 
         RowBox[{"Line", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"ompl", ",", 
              RowBox[{"-", "2"}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"ompl", ",", "0"}], "}"}]}], "}"}], "]"}]}], "}"}]}], 
      "}"}]}]}], "]"}]}]}], "Input",
